# /etc/systemd/system/babelhub.service
# Deploy: scp the binary to /usr/local/bin/babelhub, then
#   systemctl enable --now babelhub
[Unit]
Description=BabelHub server
After=network.target

[Service]
ExecStart=/usr/local/bin/babelhub
Environment=PORT=8080
# Documents are git-backed under this writable state dir (created by systemd,
# owned by the dynamic user). Requires `git` installed on the host.
StateDirectory=babelhub
Environment=BABELHUB_DATA=/var/lib/babelhub
# Gate server execution before exposing it publicly:
#   Environment=BABELHUB_EXEC=1
#   Environment=BABELHUB_TOKEN=<a long random secret>
#   Environment=BABELHUB_RATE=30
DynamicUser=yes
Restart=on-failure
RestartSec=2
# Hardening — only the state dir is writable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
